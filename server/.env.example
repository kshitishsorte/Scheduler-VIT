# Copy to .env and adjust. Every value here is optional in development.

NODE_ENV=development
PORT=5000

# Origin allowed to make credentialed requests (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Leave unset in development to run against a throwaway in-memory MongoDB.
# Set it to persist data, e.g.
#   MONGODB_URI=mongodb://127.0.0.1:27017/scheduler-vit
#   MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/scheduler-vit
# MONGODB_URI=

# Required in production, minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

JWT_EXPIRES_IN=7d
